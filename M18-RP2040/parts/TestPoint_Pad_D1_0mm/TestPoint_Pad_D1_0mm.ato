#pragma experiment("TRAITS")
import has_designator_prefix
import is_atomic_part

component TestPoint_Pad_D1_0mm_package:
    """
    Generic 1.0mm SMT test pad.
    """
    trait is_atomic_part<manufacturer="Generic", partnumber="TP_D1_0mm", footprint="TestPoint_Pad_D1.0mm.kicad_mod", symbol="TestPoint_Pad_D1.0mm.kicad_sym">
    trait has_designator_prefix<prefix="TP">

    # single contact pad
    pin 1

module TestPoint_Pad_D1_0mm:
    """
    Test pad wrapper exposing a single contact tied to the 1.0mm pad package.
    """
    signal contact
    package = new TestPoint_Pad_D1_0mm_package
    contact ~ package.1
