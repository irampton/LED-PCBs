#pragma experiment("TRAITS")
import has_designator_prefix
import is_atomic_part

component m18_10awg_pad_package:
    """Single through-hole solder pad for M18 10 AWG wiring."""

    trait is_atomic_part<manufacturer="Custom", partnumber="m18_10awg_pad", footprint="M18_10AWG_PAD.kicad_mod", symbol="m18_10awg_pad.kicad_sym">
    trait has_designator_prefix<prefix="TP">

    pin 1

module m18_10awg_pad:
    """M18 10 AWG solder pad wrapper exposing the pad contact."""

    signal contact
    package = new m18_10awg_pad_package
    contact ~ package.1
