"""light-panel - A new atopile project"""

from "LEDs.ato" import CoolLed
from "LEDs.ato" import WarmLed

from "parts/BOOMELE_2_54_2_3P/BOOMELE_2_54_2_3P.ato" import BOOMELE_2_54_2_3P_package

import ElectricPower
import ElectricLogic


module App:
    signal v
    signal gnd
    signal pwm_cool
    signal pwm_warm

    power = new ElectricPower

    power.voltage = 20V +/- 25%
    v ~ power.hv
    gnd ~ power.lv
    v.override_net_name = "V+"
    gnd.override_net_name = "GND"

    input = new BOOMELE_2_54_2_3P_package
    output = new BOOMELE_2_54_2_3P_package

    input.1 ~ power.hv
    input.2 ~ power.hv
    input.3 ~ pwm_cool
    input.4 ~ pwm_warm
    input.5 ~ power.lv
    input.6 ~ power.lv

    output.1 ~ power.hv
    output.2 ~ power.hv
    output.3 ~ pwm_cool
    output.4 ~ pwm_warm
    output.5 ~ power.lv
    output.6 ~ power.lv

    cool_led = new CoolLed
    warm_led = new WarmLed

    power.hv ~ cool_led.channel.power_in.hv
    power.lv ~ cool_led.channel.power_in.lv
    power.hv ~ warm_led.channel.power_in.hv
    power.lv ~ warm_led.channel.power_in.lv

    pwm_cool ~ cool_led.channel.PWM
    pwm_warm ~ warm_led.channel.PWM