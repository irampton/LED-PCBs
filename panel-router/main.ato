"""panel-router - A new atopile project"""

from "parts/BOOMELE_2_54_2_3P/BOOMELE_2_54_2_3P.ato" import BOOMELE_2_54_2_3P_package
from "parts/CUI_PJ_002BH/CUI_PJ_002BH.ato" import CUI_PJ_002BH_package

import ElectricPower

module App:
    signal v
    signal gnd
    signal pwm_cool
    signal pwm_warm

    power = new ElectricPower

    power.voltage = 20V +/- 25%
    v ~ power.hv
    gnd ~ power.lv
    v.override_net_name = "V+"
    gnd.override_net_name = "GND"

    header_1 = new BOOMELE_2_54_2_3P_package
    header_2 = new BOOMELE_2_54_2_3P_package
    header_3 = new BOOMELE_2_54_2_3P_package
    dc_input = new CUI_PJ_002BH_package

    header_1.1 ~ power.hv
    header_1.2 ~ power.hv
    header_1.3 ~ pwm_cool
    header_1.4 ~ pwm_warm
    header_1.5 ~ power.lv
    header_1.6 ~ power.lv

    header_2.1 ~ power.hv
    header_2.2 ~ power.hv
    header_2.3 ~ pwm_cool
    header_2.4 ~ pwm_warm
    header_2.5 ~ power.lv
    header_2.6 ~ power.lv

    header_3.1 ~ power.hv
    header_3.2 ~ power.hv
    header_3.3 ~ pwm_cool
    header_3.4 ~ pwm_warm
    header_3.5 ~ power.lv
    header_3.6 ~ power.lv

    dc_input.1 ~ power.hv
    dc_input.2 ~ power.lv
    dc_input.3 ~ power.lv
