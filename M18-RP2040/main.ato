#pragma experiment("FOR_LOOP")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("TRAITS")

"""M18-RP2040 - A Battery Powered General Purpose RP2040 Based Dev Board"""

import ElectricPower
import USB2_0
import Resistor
import Capacitor

from "../rp2040.ato" import RP2040_driver
from "../dc-dc_buck.ato" import DCDC_Buck

from "parts/Advanced_Monolithic_Systems_AMS1117_3_3/Advanced_Monolithic_Systems_AMS1117_3_3.ato" import Advanced_Monolithic_Systems_AMS1117_3_3_package
from "parts/Hanbo_Electronic_MC_403L68_Z20/Hanbo_Electronic_MC_403L68_Z20.ato" import Hanbo_Electronic_MC_403L68_Z20_package
from "parts/MDD_Microdiode_Electronics_SS34/MDD_Microdiode_Electronics_SS34.ato" import MDD_Microdiode_Electronics_SS34_package
from "parts/CUI_PJ_002BH/CUI_PJ_002BH.ato" import CUI_PJ_002BH_package
from "parts/FOJAN_FRM121WFR010TM/FOJAN_FRM121WFR010TM.ato" import FOJAN_FRM121WFR010TM_package
from "parts/Texas_Instruments_INA181A2IDBVR/Texas_Instruments_INA181A2IDBVR.ato" import Texas_Instruments_INA181A2IDBVR_package
from "parts/Ningbo_Kangnex_Elec_WJ127_5_0_02P_14_00A/Ningbo_Kangnex_Elec_WJ127_5_0_02P_14_00A.ato" import Ningbo_Kangnex_Elec_WJ127_5_0_02P_14_00A_package
from "parts/Changjiang_Electronics_Tech_2N7002/Changjiang_Electronics_Tech_2N7002.ato" import Changjiang_Electronics_Tech_2N7002_package
from "parts/m18_10awg_pad/m18_10awg_pad.ato" import m18_10awg_pad
from "parts/BOOMELE_2_54_2_3P/BOOMELE_2_54_2_3P.ato" import BOOMELE_2_54_2_3P_package
from "parts/BOOMELE_2_54_1_3P/BOOMELE_2_54_1_3P.ato" import BOOMELE_2_54_1_3P_package

module App:
    # Set up power lines
    power = new ElectricPower
    power.voltage = 18V +/- 20%
    power_5v = new ElectricPower
    power_5v.voltage = 5V +/- 10%
    power_3v3 = new ElectricPower
    power_3v3.voltage = 3.3V +/- 5%

    # Get the power line names correct
    signal V
    signal fiveVin
    signal fiveV
    signal threeV
    signal oneV
    signal gnd
    V.override_net_name = "V+"
    fiveV.override_net_name = "5V"
    fiveVin.override_net_name = "5Vin"
    threeV.override_net_name = "3V3"
    oneV.override_net_name = "1V1"
    gnd.override_net_name = "GND"

    # Tie the grounds together and set the names
    power.hv ~ V
    power.lv ~ gnd
    power_5v.hv ~ fiveV
    power_5v.lv ~ gnd
    power_3v3.hv ~ threeV
    power_3v3.lv ~ gnd

    # Buck to 5V
    buck = new DCDC_Buck
    buck.target_voltage = 5.2V +/- 5%
    power ~ buck.power_in
    buck.power_out.hv ~ fiveVin

    # Handle the LDO (create 3V3 from ~5V)
    ldo = new Advanced_Monolithic_Systems_AMS1117_3_3_package
    power_5v.hv ~ ldo.VIN
    power_3v3.hv ~ ldo.VOUT
    gnd ~ ldo.GND

    cin = new Capacitor
    cin.capacitance = 10uF +/- 20%
    power_5v.hv ~> cin ~> gnd

    cout = new Capacitor
    cout.capacitance = 22uF +/- 20%
    power_3v3.hv ~> cout ~> gnd

    # Hook up the RP2040
    RP2040 = new RP2040_driver
    RP2040.power_3v3 ~ power_3v3
    RP2040.power_1V.hv ~ oneV

    # USB Connection
    usb_port = new Hanbo_Electronic_MC_403L68_Z20_package
    usb_power_diode = new MDD_Microdiode_Electronics_SS34_package

    # USB Power
    usb_port.VBUS.override_net_name = "vUSB"
    usb_port.VBUS ~ usb_power_diode.A
    usb_power_diode.K ~ fiveVin
    usb_port.GND ~ gnd
    usb_port.EH ~ gnd

    # Request power via CC resistors
    CC1_resistor = new Resistor
    CC1_resistor.resistance = 5.1kohms +/- 5%
    CC1_resistor.package = "R0402"
    usb_port.CC1 ~> CC1_resistor ~> gnd
    usb_port.CC1.override_net_name = "CC1"

    CC2_resistor = new Resistor
    CC2_resistor.resistance = 5.1kohms +/- 5%
    CC2_resistor.package = "R0402"
    usb_port.CC2 ~> CC2_resistor ~> gnd
    usb_port.CC2.override_net_name = "CC2"

    # USB Data
    usb_port.DP1 ~ RP2040.usb_p
    usb_port.DN1 ~ RP2040.usb_n

    # 5V Shunt
    v5in_sense_amp = new Texas_Instruments_INA181A2IDBVR_package
    v5in_shunt = new FOJAN_FRM121WFR010TM_package # 10mOhm 1W shunt
    v5in_sense_r1 = new Resistor
    v5in_sense_r1.resistance = 220ohm +/- 1%
    v5in_sense_r1.package = "0402"
    v5in_sense_c1 = new Capacitor
    v5in_sense_c1.capacitance = 10nF +/- 10%
    assert v5in_sense_c1.max_voltage within 6V to 75V
    v5in_sense_c1.package = "0402"

    fiveVin ~ v5in_shunt.1
    v5in_shunt.2 ~ fiveV
    v5in_sense_amp.INpos ~ fiveVin
    v5in_sense_amp.INneg ~ fiveV
    v5in_sense_amp.VS ~ power_3v3.hv
    v5in_sense_amp.GND ~ gnd
    v5in_sense_amp.REF ~ gnd
    v5in_sense_amp.OUT ~> v5in_sense_r1 ~> RP2040.gpio26_a0
    RP2040.gpio26_a0 ~> v5in_sense_c1 ~> gnd

    # Power In
    signal VIN

    # DC Jack
    dc_jack = new CUI_PJ_002BH_package
    dc_en_pullup = new Resistor
    dc_en_pullup.resistance = 10kohm +/- 1%
    dc_en_pullup.package = "0603"

    dc_jack.1 ~> VIN
    dc_jack.2 ~> gnd
    dc_jack.3 ~> dc_en_pullup ~> power_3v3.hv
    dc_jack.3 ~ RP2040.gpio25

    # M18
    signal DP
    signal DC

    m18_pos = new m18_10awg_pad
    m18_gnd = new m18_10awg_pad
    m18_comm_terminal = new Ningbo_Kangnex_Elec_WJ127_5_0_02P_14_00A_package
    dp_nmos = new Changjiang_Electronics_Tech_2N7002_package
    dc_nmos = new Changjiang_Electronics_Tech_2N7002_package
    dp_pullup = new Resistor
    dp_pullup.resistance = 10kohm +/- 1%
    dp_pullup.package = "0603"
    dp_ctrl = new Resistor
    dp_ctrl.resistance = 330ohm +/- 1%
    dp_ctrl.package = "0402"
    dc_pullup = new Resistor
    dc_pullup.resistance = 10kohm +/- 1%
    dc_pullup.package = "0603"

    m18_pos.contact ~ VIN
    m18_gnd.contact ~ gnd
    m18_comm_terminal.1 ~ DP
    m18_comm_terminal.2 ~ DC

    VIN ~> dp_pullup ~> dp_nmos.D
    DP ~ dp_nmos.D
    dp_nmos.S ~ gnd
    dp_nmos.G ~> dp_ctrl ~> RP2040.gpio18

    DC ~ dc_nmos.G
    power_3v3.hv ~> dc_pullup ~> dc_nmos.D
    dc_nmos.S ~ gnd
    dc_nmos.D ~ RP2040.gpio19

    # Shunt
    vin_sense_amp = new Texas_Instruments_INA181A2IDBVR_package
    vin_shunt = new FOJAN_FRM121WFR010TM_package # 10mOhm 1W shunt
    vin_sense_r1 = new Resistor
    vin_sense_r1.resistance = 220ohm +/- 1%
    vin_sense_r1.package = "0402"
    vin_sense_c1 = new Capacitor
    vin_sense_c1.capacitance = 10nF +/- 10%
    assert vin_sense_c1.max_voltage within 6V to 75V
    vin_sense_c1.package = "0402"

    VIN ~ vin_shunt.1
    vin_shunt.2 ~ power.hv
    vin_sense_amp.INpos ~ VIN
    vin_sense_amp.INneg ~ power.hv
    vin_sense_amp.VS ~ power_3v3.hv
    vin_sense_amp.GND ~ gnd
    vin_sense_amp.REF ~ gnd
    vin_sense_amp.OUT ~> vin_sense_r1 ~> RP2040.gpio28_a2
    RP2040.gpio28_a2 ~> vin_sense_c1 ~> gnd

    # Voltage Sense
    vin_vsense_r1 = new Resistor
    vin_vsense_r1.resistance = 150kohm +/- 1%
    vin_vsense_r1.package = "0603"
    vin_vsense_r2 = new Resistor
    vin_vsense_r2.resistance = 22kohm +/- 1%
    vin_vsense_r2.package = "0603"

    VIN ~> vin_vsense_r1 ~> RP2040.gpio27_a1
    RP2040.gpio27_a1 ~> vin_vsense_r2 ~> gnd

    # Power headers
    header_1 = new BOOMELE_2_54_2_3P_package
    header_1.1 ~ power.hv
    header_1.5 ~ power.hv
    header_1.3 ~ RP2040.gpio0
    RP2040.gpio0.override_net_name = "GPIO0"
    header_1.4 ~ RP2040.gpio1
    RP2040.gpio1.override_net_name = "GPIO1"
    header_1.2 ~ power.lv
    header_1.6 ~ power.lv

    header_2 = new BOOMELE_2_54_2_3P_package
    header_2.1 ~ power.hv
    header_2.5~ power.hv
    header_2.3 ~ RP2040.gpio2
    RP2040.gpio2.override_net_name = "GPIO2"
    header_2.4 ~ RP2040.gpio3
    RP2040.gpio3.override_net_name = "GPIO3"
    header_2.2 ~ power.lv
    header_2.6 ~ power.lv

    header_3 = new BOOMELE_2_54_2_3P_package
    header_3.1 ~ power.hv
    header_3.5 ~ power.hv
    header_3.3 ~ RP2040.gpio4
    RP2040.gpio4.override_net_name = "GPIO4"
    header_3.4 ~ RP2040.gpio5
    RP2040.gpio5.override_net_name = "GPI54"
    header_3.2 ~ power.lv
    header_3.6 ~ power.lv

    WS2812b_1 = new BOOMELE_2_54_1_3P_package
    WS2812b_1.1 ~ gnd
    WS2812b_1.2 ~ RP2040.gpio13
    RP2040.gpio13.override_net_name = "GPIO13"
    WS2812b_1.3 ~ power_5v.hv

    WS2812b_2 = new BOOMELE_2_54_1_3P_package
    WS2812b_2.1 ~ gnd
    WS2812b_2.2 ~ RP2040.gpio12
    RP2040.gpio12.override_net_name = "GPIO12"
    WS2812b_2.3 ~ power_5v.hv

    # GPIO, useful for SPI, I2C, UART, etc.
    gpio = new BOOMELE_2_54_2_3P_package
    gpio.1 ~ gnd
    gpio.2 ~ RP2040.gpio9
    gpio.3 ~ RP2040.gpio11
    gpio.4 ~ RP2040.gpio10
    gpio.5 ~ power_3v3.hv
    gpio.6 ~ RP2040.gpio8
