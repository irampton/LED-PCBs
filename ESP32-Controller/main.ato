"""ESP32-Controller"""


from "parts/BOOMELE_2_54_2_3P/BOOMELE_2_54_2_3P.ato" import BOOMELE_2_54_2_3P_package
from "parts/BOOMELE_2_54_1_3P/BOOMELE_2_54_1_3P.ato" import BOOMELE_2_54_1_3P_package
from "parts/CUI_PJ_002BH/CUI_PJ_002BH.ato" import CUI_PJ_002BH_package
from "parts/Advanced_Monolithic_Systems_AMS1117_3_3/Advanced_Monolithic_Systems_AMS1117_3_3.ato" import Advanced_Monolithic_Systems_AMS1117_3_3_package
from "parts/Hanbo_Electronic_MC_403L68_Z20/Hanbo_Electronic_MC_403L68_Z20.ato" import Hanbo_Electronic_MC_403L68_Z20_package
from "parts/MDD_Microdiode_Electronics_SS34/MDD_Microdiode_Electronics_SS34.ato" import MDD_Microdiode_Electronics_SS34_package

from "../dc-dc_buck.ato" import DCDC_Buck
from "../ESP32-C3-Full.ato" import ESP32_C3_Full

import ElectricPower
import Capacitor
import Resistor

module App:
    signal v
    signal fiveV
    signal threeV
    signal gnd
    signal pwm_cool
    signal pwm_warm

    v.override_net_name = "V+"
    fiveV.override_net_name = "5V"
    gnd.override_net_name = "GND"
    threeV.override_net_name = "3V3"

    power = new ElectricPower
    power.voltage = 20V +/- 25%

    v ~ power.hv
    gnd ~ power.lv

    power_5v = new ElectricPower
    power_5v.voltage = 5.2V +/- 5%
    power_3v3 = new ElectricPower
    power_3v3.voltage = 3.3V +/- 5%

    buck = new DCDC_Buck
    buck.target_voltage = 5.2V +/- 5%
    ldo = new _AMS1117_3V3
    esp32 = new ESP32_C3_Full

    power ~ buck.power_in
    buck.power_out ~ power_5v
    power_5v ~ ldo.power_in
    ldo.power_out ~ power_3v3
    power_3v3 ~ esp32.power3v3
    power_5v.hv ~ fiveV
    power_3v3.hv ~ threeV


    # Connectors
    header_1 = new BOOMELE_2_54_2_3P_package
    dc_input = new CUI_PJ_002BH_package

    # Stacking Header
    header_1.1 ~ power.hv
    header_1.5 ~ power.hv
    header_1.3 ~ pwm_cool
    header_1.4 ~ pwm_warm
    header_1.2 ~ power.lv
    header_1.6 ~ power.lv

    # USB
    usb_port = new Hanbo_Electronic_MC_403L68_Z20_package
    usb_power_diode = new MDD_Microdiode_Electronics_SS34_package

    usb_port.VBUS.override_net_name = "vUSB"
    usb_port.VBUS ~ usb_power_diode.A
    usb_power_diode.K ~ power_5v.hv
    usb_port.GND ~ gnd
    usb_port.EH ~ gnd
    usb_port.DN1 ~ esp32.usb_n
    usb_port.DP1 ~ esp32.usb_p

    # Request power via CC resistors
    CC1_resistor = new Resistor
    CC1_resistor.resistance = 5.1kohms +/- 5%
    CC1_resistor.package = "R0402"
    usb_port.CC1 ~> CC1_resistor ~> gnd
    usb_port.CC1.override_net_name = "CC1"

    CC2_resistor = new Resistor
    CC2_resistor.resistance = 5.1kohms +/- 5%
    CC2_resistor.package = "R0402"
    usb_port.CC2 ~> CC2_resistor ~> gnd
    usb_port.CC2.override_net_name = "CC2"

    # DC input jack
    # USB Diode allows for (very bad) source selection
    dc_input.1 ~ power.hv
    dc_input.2 ~ power.lv
    dc_input.3 ~ power.lv

    # PWM Pins
    pwm_cool ~ esp32.pins.3
    pwm_warm ~ esp32.pins.4

    # Optional WS2812b headers (only do <2.5A through these)
    WS2812b_1 = new BOOMELE_2_54_1_3P_package
    WS2812b_1.1 ~ gnd
    WS2812b_1.2 ~ esp32.pins.17
    WS2812b_1.3 ~ power_5v.hv

    WS2812b_2 = new BOOMELE_2_54_1_3P_package
    WS2812b_2.1 ~ gnd
    WS2812b_2.2 ~ esp32.pins.15
    WS2812b_2.3 ~ power_5v.hv


module _AMS1117_3V3:
    power_in = new ElectricPower
    power_out = new ElectricPower

    ldo = new Advanced_Monolithic_Systems_AMS1117_3_3_package
    cin = new Capacitor
    cout = new Capacitor

    cin.capacitance = 10uF +/- 20%
    cout.capacitance = 22uF +/- 20%

    power_in.hv ~ ldo.VIN
    power_in.lv ~ ldo.GND

    power_out.hv ~ ldo.VOUT
    power_out.lv ~ ldo.GND

    cin.unnamed[0] ~ power_in.hv
    cin.unnamed[1] ~ power_in.lv

    cout.unnamed[0] ~ power_out.hv
    cout.unnamed[1] ~ power_out.lv
